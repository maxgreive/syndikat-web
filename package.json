{
  "name": "syndikat-web",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build:assets": "run-p build:svelte build:css",
    "build:critical": "npm run install:chrome && node critical.js",
    "build:css": "node scripts/minify-css.mjs",
    "build:site": "NODE_ENV=production eleventy",
    "compare:site": "node scripts/compare-site.mjs",
    "build:svelte": "npm run build -C svelte-components",
    "build": "run-s clean build:assets build:site build:critical",
    "clean": "node scripts/clean.mjs",
    "dev:site": "eleventy --serve --port=4000",
    "dev:svelte": "npm run --prefix svelte-components dev",
    "dev": "run-p dev:svelte dev:site",
    "install:chrome": "puppeteer browsers install chrome",
    "prepare": "husky",
    "start": "npm run dev",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-terser": "^0.4.0",
    "awesomplete": "^1.1.7",
    "clean-css": "^5.3.3",
    "concurrently": "^9.2.1",
    "husky": "^9.0.11",
    "lucide-static": "^1.12.0",
    "lucide-svelte": "^1.0.1",
    "npm-run-all": "^4.1.5",
    "rollup": "^3.15.0",
    "rollup-plugin-css-only": "^4.3.0",
    "rollup-plugin-svelte": "^7.1.2",
    "svelte": "^3.55.0",
    "svelte-spa-router": "^4.0.1",
    "tippy.js": "^6.3.7"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.1",
    "linkedom": "^0.18.13",
    "markdown-it": "^15.0.1",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "penthouse-esm": "^3.0.0"
  }
}
