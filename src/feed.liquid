---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
<title>{{ settings.title | escape }}</title>
<subtitle>{{ settings.description | escape }}</subtitle>
<link href="{{ '/feed.xml' | absoluteUrl }}" rel="self" type="application/atom+xml"/>
<link href="{{ settings.url }}" rel="alternate" type="text/html"/>
<id>{{ '/feed.xml' | absoluteUrl }}</id>
<updated>{{ collections.posts.first.date | date: "%Y-%m-%dT%H:%M:%S%:z" }}</updated>
{% for post in collections.posts limit: 10 %}
<entry>
<title>{{ post.data.title | escape }}</title>
<link href="{{ post.url | absoluteUrl }}" rel="alternate" type="text/html"/>
<id>{{ post.url | absoluteUrl | remove_last: '/' }}</id>
<published>{{ post.date | date: "%Y-%m-%dT%H:%M:%S%:z" }}</published>
<updated>{{ post.data.last_modified_at | default: post.date | date: "%Y-%m-%dT%H:%M:%S%:z" }}</updated>
<content type="html" xml:base="{{ post.url | absoluteUrl }}">{{ post.templateContent | escape }}</content>
{% if post.data.author %}<author><name>{{ people[post.data.author].name | escape }}</name></author>{% else %}{% for id in post.data.authors %}<author><name>{{ people[id].name | escape }}</name></author>{% endfor %}{% endif %}
{% for tag in post.data.tags %}{% unless tag == 'posts' %}<category term="{{ tag | escape }}"/>{% endunless %}{% endfor %}
</entry>
{% endfor %}
</feed>
