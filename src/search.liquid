---
permalink: /search.json
eleventyExcludeFromCollections: true
---
[
{% assign entries = collections.posts %}
{% for item in entries %}
  {% capture article %}{% include 'components/post_card.html', item: item, lazy: false %}{% endcapture %}
  {"title": {{ item.data.title | json }}, "category": {{ item.data.category | default: '' | json }},
   "tags": {{ item.data.tags | join: ', ' | json }}, "url": {{ item.url | json }},
   "date": {{ item.date | date: "%Y-%m-%dT%H:%M:%S%:z" | json }},
   "content": {{ item.templateContent | strip_html | strip_newlines | json }},
   "article": {{ article | json }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
